# Copy file này thành .env.local rồi điền key. Không đưa key lên Git.
OPENAI_API_KEY=
# Model phải khả dụng trên tài khoản API của bạn; có thể thay đổi.
TEXT_MODEL=gpt-4o-mini
LOW_COST_MODE=true
IMAGE_MODEL=gpt-image-1

# Local API dev mặc định 3001, giao diện localhost:3000.
# API_PORT=3001
# PORT=3000
# DATA_DIR=./data
