# Copy file này thành .env.local rồi điền key. Không đưa key lên Git.
OPENAI_API_KEY=
# Model phải khả dụng trên tài khoản API của bạn; có thể thay đổi.
TEXT_MODEL=gpt-4o-mini
# Cache/bài ngắn vẫn tiết kiệm; chế độ ảnh AI/bìa miễn phí chọn riêng trong UI.
LOW_COST_MODE=true
IMAGE_MODEL=gpt-image-2.5-flare

# Local API dev mặc định 3001, giao diện localhost:3000.
# API_PORT=3001
# PORT=3000
# DATA_DIR=./data

# Bắt buộc để đăng nhập /admin, cả local và production. Tự đặt mật khẩu mạnh.
ACCESS_USERNAME=
ACCESS_PASSWORD=
